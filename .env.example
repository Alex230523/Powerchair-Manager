# Local only; use managed secrets and TLS outside development.
DATABASE_URL=postgresql://pfm:pfm_local_only@localhost:5432/pfm

BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a random secret (at least 32 characters); never commit the real value.
BETTER_AUTH_SECRET=
# Development capture only; keep MAIL_TRANSPORT=local for local testing.
PFM_LOCAL_MAIL=true

# Defaults to local capture. External delivery is an explicit operator action.
MAIL_TRANSPORT=local
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=


# Address shown on the « Rejoindre la plateforme » page to federations that want to join.
PFM_CONTACT_EMAIL=

# B2, production (see docs/PRODUCTION.md). Nothing below is needed locally.
# External mail: also set MAIL_TRANSPORT=smtp and the SMTP_* lines above.
MAIL_ALLOW_EXTERNAL=false
# The free plan's daily mail limit (for instance 300); the rest leaves the next day.
MAIL_DAILY_LIMIT=
# Mails sent per cron run (50 by default).
MAIL_BATCH=
# Opens /api/cron/<task> to the scheduler (at least 32 random characters).
CRON_SECRET=
# B4: phone notifications (Web Push). Generate once with `node scripts/vapid-keys.mjs`;
# without them the phone card says it is not switched on. PUSH_TRANSPORT=local writes them to PFM_PUSH_DIR.
PFM_VAPID_PUBLIC_KEY=
PFM_VAPID_PRIVATE_KEY=
PFM_VAPID_SUBJECT=
# true once a scheduler calls the cron routes: a task that never ran then shows as late.
PFM_JOBS_EXPECTED=false
# Who hears that a background task is late.
OPS_ALERT_EMAIL=
# Where file contents are kept: postgres (the only one today).
STORAGE_DRIVER=postgres
