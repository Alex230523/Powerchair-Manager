{
  "name": "powerchair-football-manager",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:db": "node --env-file=.env.local scripts/e2e-db.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:test": "node --env-file=.env.local scripts/db-test.mjs",
    "admin:bootstrap": "tsx --env-file=.env.local scripts/bootstrap.ts",
    "admin:account": "tsx --env-file=.env.local scripts/account-status.ts",
    "demo:seed": "tsx --env-file=.env.local scripts/demo-seed.ts",
    "demo:start": "bash scripts/demo-start.sh",
    "mail:worker": "tsx --env-file=.env.local scripts/mail-worker.ts",
    "docs:worker": "tsx --env-file=.env.local scripts/documents-worker.ts",
    "attendance:worker": "tsx --env-file=.env.local scripts/attendance-worker.ts",
    "i18n:export": "tsx scripts/i18n-export.ts"
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "nodemailer": "10.1.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "smtp-server": "3.20.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
